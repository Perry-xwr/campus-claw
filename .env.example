# 可选文件：**不设置任何环境变量也能直接 `python app.py` 启动并登录**，
# 此时使用代码内置的测试凭据（见 README「预置账号」）。
#
# 本文件只用于覆盖内置默认值。用法：复制为 .env 后填写。
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
#
# `python app.py` 与 `python -m campusclaw.index_worker` 启动时会自动读取
# **项目根目录**的 .env（仅补齐缺失项，不覆盖已存在的进程环境变量）；
# `docker compose` 由 Compose 自己读取同名变量。文件不存在时一切照常运行。
# .env 已被 .gitignore 忽略，不会进入版本库。

# 会话签名密钥：任意非空白随机字符串。留空则使用内置开发密钥。
SECRET_KEY=

# 四个预置账号的初始口令：UTF-8 字节长度须为 8～72。
# 留空则使用内置测试口令；若填写但长度非法，初始化会被拒绝。
SEED_TEACHER_A_PASSWORD=
SEED_STUDENT_A1_PASSWORD=
SEED_STUDENT_B1_PASSWORD=
SEED_TEACHER_B_PASSWORD=

# 可选：HTTPS 部署时必须为 true，会话 Cookie 将附加 Secure 属性。
AUTH_COOKIE_SECURE=false

# 可选：设为 1 启用严格模式——SECRET_KEY 或种子口令缺失时直接启动失败，
# 不再回落到内置默认值。正式环境建议开启。
# CAMPUSCLAW_STRICT_CONFIG=1

# 可选：仅 Docker Compose 使用，改宿主机映射端口（容器内固定 8080）。
# CAMPUSCLAW_PORT=8080

# 第 4 课：仅服务端读取的 OpenAI 兼容接口配置。留空时可用关键词检索，
# 向量检索/混合检索和问答会返回 503；索引任务显示失败，可在配置后重试。
#
# 两组各管一条链路、互不影响，base_url 都以 /v1 结尾，三个变量必须同时非空才生效。
#
# 填写示例（任选服务商，模型名按你的账号可用模型填）：
#   阿里云百炼（对话）  CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                      CHAT_MODEL=qwen-plus（或 qwen-max / qwen-turbo 等）
#   硅基流动（向量）    EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#                      EMBEDDING_MODEL=BAAI/bge-m3（1024 维）
#   DeepSeek（对话）    CHAT_BASE_URL=https://api.deepseek.com/v1
#
# 注意：换嵌入模型可能改变向量维度；若 Qdrant 已有集合且维度不同，索引会报
# "Qdrant collection vector dimension differs from embedding model"，
# 此时换一个 QDRANT_COLLECTION 名字（或删掉旧集合）再重建索引。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=

# 本地 langdev 默认连接 Docker Qdrant 的 localhost:6333。
# 容器内由 Compose 固定使用 http://qdrant:6333。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=campusclaw_chunks

# 第 5 课：解题助手生成层开关。留空（默认）时配置了 CHAT_* 走 LangChain
# ChatOpenAI.stream，未配置则走确定性本地流式回退；设为 1 时换固定响应模型
# 替身（不发起任何外部模型调用，供 apitest / acceptance_tutor 离线断言）。
# CAMPUSCLAW_TUTOR_STUB=0

# 第 6 课：自建 MCP 工具服务（mcp-server）的 Bearer 令牌。仅服务端从环境变量
# 读取，不进 Git/镜像/前端/日志；未设置时 mcp-server 拒绝启动。教师登记本班
# MCP 服务器时填同一值入库（也仅存服务端）。两侧须保持一致，可自行修改。
MCP_AUTH_TOKEN=

# 第 10 课：轻量端（H5）跨源白名单。逗号分隔的完整来源（含协议与端口）。
# 轻量端页面由本服务渲染时是同源，不需要配置；把页面放到别的静态站、
# 接口仍在本服务时才需要把那个来源写进来。留空 = 不产生任何 CORS 响应头。
# 示例：CORS_ORIGINS=http://192.168.1.20:8088,https://claw.example.edu
CORS_ORIGINS=
